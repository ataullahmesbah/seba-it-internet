// SEBA IT Internet — White-label ISP platform (PRD v1.1, Section 10)
// One deployment + one PostgreSQL database per ISP in V1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ───────────────────────────── Enums (Appendix A) ─────────────────────────────

enum Locale {
  EN
  BN
}

enum ServiceType {
  HOME
  CORPORATE
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

enum ConnectionStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  CONVERTED
  CLOSED
  SPAM
}

enum CorporateLeadStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  WON
  LOST
  CLOSED
  SPAM
}

enum LeadStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  CONVERTED
  CLOSED
  SPAM
}

enum ContactStatus {
  UNREAD
  READ
  REPLIED
  CLOSED
  SPAM
}

enum ChatStatus {
  WAITING
  ACTIVE
  RESOLVED
  CLOSED
}

enum ChatSenderType {
  VISITOR
  STAFF
  SYSTEM
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PaymentType {
  BKASH
  NAGAD
  ROCKET
  BANK
}

enum OfficeType {
  HEAD_OFFICE
  BRANCH
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum MediaCategory {
  LOGO
  HERO
  BLOG
  REVIEW
  OFFICE
  PAYMENT_QR
  GENERAL
}

enum NavLocation {
  HEADER
  FOOTER_COMPANY
  FOOTER_INTERNET
  FOOTER_SUPPORT
  FOOTER_LEGAL
}

enum NotificationType {
  CHAT_NEW
  CHAT_MESSAGE
  CONNECTION_NEW
  CORPORATE_INQUIRY_NEW
  CONTACT_NEW
  COVERAGE_INTEREST_NEW
  SECURITY_LOGIN_NEW_DEVICE
  SYSTEM_PROVIDER_FAILURE
}

// ───────────────────────────── Identity & access ─────────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  displayName     String
  passwordHash    String
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  roles               UserRole[]
  sessions            Session[]
  totp                TotpCredential?
  passwordResetTokens PasswordResetToken[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  assignedChats       ChatConversation[]
  chatMessages        ChatMessage[]
  blogPosts           BlogPost[]
  media               Media[]
  siteSettings        SiteSetting[]
  connectionHistory   LeadStatusHistory[]

  @@index([isActive])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  label       String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String
  roles       RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id              String    @id @default(cuid())
  userId          String
  tokenHash       String    @unique
  expiresAt       DateTime
  lastSeenAt      DateTime  @default(now())
  ipHash          String?
  userAgent       String?
  twoFactorPassed Boolean   @default(false)
  reauthAt        DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model TotpCredential {
  userId            String    @id
  secretEncrypted   String
  enabledAt         DateTime?
  recoveryCodesHash Json      @default("[]")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────────── Brand & settings ─────────────────────────────

model BrandSetting {
  id               String   @id @default("singleton")
  companyName      String
  shortName        String?
  taglineEn        String?
  taglineBn        String?
  descriptionEn    String?  @db.Text
  descriptionBn    String?  @db.Text
  logoLightMediaId String?
  logoDarkMediaId  String?
  faviconMediaId   String?
  defaultOgMediaId String?
  primaryColor     String   @default("#0A66FF")
  secondaryColor   String   @default("#071A2E")
  accentColor      String   @default("#00BCEB")
  hotline          String?
  salesPhone       String?
  supportEmail     String?
  salesEmail       String?
  whatsappUrl      String?
  messengerUrl     String?
  updatedAt        DateTime @updatedAt

  logoLight Media? @relation("BrandLogoLight", fields: [logoLightMediaId], references: [id], onDelete: SetNull)
  logoDark  Media? @relation("BrandLogoDark", fields: [logoDarkMediaId], references: [id], onDelete: SetNull)
  favicon   Media? @relation("BrandFavicon", fields: [faviconMediaId], references: [id], onDelete: SetNull)
  defaultOg Media? @relation("BrandDefaultOg", fields: [defaultOgMediaId], references: [id], onDelete: SetNull)
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [updatedBy], references: [id], onDelete: SetNull)
}

model SocialLink {
  id           String   @id @default(cuid())
  platform     String
  url          String
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model NavigationItem {
  id           String      @id @default(cuid())
  location     NavLocation
  labelEn      String
  labelBn      String
  url          String
  external     Boolean     @default(false)
  newTab       Boolean     @default(false)
  active       Boolean     @default(true)
  displayOrder Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([location, displayOrder])
}

// ───────────────────────────── Pages & CMS ─────────────────────────────

model Page {
  id        String        @id @default(cuid())
  key       String        @unique
  titleEn   String
  titleBn   String
  contentEn String?       @db.Text
  contentBn String?       @db.Text
  status    PageStatus    @default(PUBLISHED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  sections  PageSection[]
}

model PageSection {
  id           String   @id @default(cuid())
  pageId       String
  type         String
  data         Json
  enabled      Boolean  @default(true)
  displayOrder Int      @default(0)
  updatedAt    DateTime @updatedAt
  page         Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, type])
  @@index([pageId, displayOrder])
}

model SeoEntry {
  id            String   @id @default(cuid())
  routeKey      String   @unique
  titleEn       String?
  titleBn       String?
  descriptionEn String?
  descriptionBn String?
  ogMediaId     String?
  indexable     Boolean  @default(true)
  updatedAt     DateTime @updatedAt
  ogMedia       Media?   @relation(fields: [ogMediaId], references: [id], onDelete: SetNull)
}

// ───────────────────────────── Packages & services ─────────────────────────────

model Package {
  id                 String              @id @default(cuid())
  slug               String              @unique
  nameEn             String
  nameBn             String
  taglineEn          String?
  taglineBn          String?
  speedMbps          Int
  price              Decimal             @db.Decimal(12, 2)
  oldPrice           Decimal?            @db.Decimal(12, 2)
  billingPeriod      String              @default("MONTHLY")
  installationNoteEn String?
  installationNoteBn String?
  vatNoteEn          String?
  vatNoteBn          String?
  popular            Boolean             @default(false)
  featured           Boolean             @default(false)
  offerBadgeEn       String?
  offerBadgeBn       String?
  iconKey            String?
  active             Boolean             @default(true)
  archivedAt         DateTime?
  displayOrder       Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  features           PackageFeature[]
  connectionRequests ConnectionRequest[]

  @@index([active, displayOrder])
}

model PackageFeature {
  id           String  @id @default(cuid())
  packageId    String
  labelEn      String
  labelBn      String
  displayOrder Int     @default(0)
  package      Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, displayOrder])
}

model CorporateService {
  id            String   @id @default(cuid())
  slug          String   @unique
  titleEn       String
  titleBn       String
  descriptionEn String   @db.Text
  descriptionBn String   @db.Text
  iconKey       String?
  mediaId       String?
  active        Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  media         Media?   @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([active, displayOrder])
}

// ───────────────────────────── Coverage ─────────────────────────────

model District {
  id                 String              @id @default(cuid())
  nameEn             String
  nameBn             String
  slug               String              @unique
  active             Boolean             @default(true)
  displayOrder       Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  thanas             Thana[]
  connectionRequests ConnectionRequest[]
  corporateInquiries CorporateInquiry[]
  coverageInterests  CoverageInterest[]

  @@index([active, displayOrder])
}

model Thana {
  id                 String              @id @default(cuid())
  districtId         String
  nameEn             String
  nameBn             String
  slug               String
  active             Boolean             @default(true)
  displayOrder       Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  district           District            @relation(fields: [districtId], references: [id], onDelete: Restrict)
  areas              CoverageArea[]
  connectionRequests ConnectionRequest[]
  corporateInquiries CorporateInquiry[]
  coverageInterests  CoverageInterest[]

  @@unique([districtId, slug])
  @@index([districtId, active, displayOrder])
}

model CoverageArea {
  id                 String              @id @default(cuid())
  thanaId            String
  nameEn             String
  nameBn             String
  slug               String
  active             Boolean             @default(true)
  publicNoteEn       String?
  publicNoteBn       String?
  internalNote       String?
  displayOrder       Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  thana              Thana               @relation(fields: [thanaId], references: [id], onDelete: Restrict)
  connectionRequests ConnectionRequest[]
  coverageInterests  CoverageInterest[]

  @@unique([thanaId, slug])
  @@index([thanaId, active, displayOrder])
}

// ───────────────────────────── Leads ─────────────────────────────

model CoverageInterest {
  id               String        @id @default(cuid())
  referenceCode    String        @unique
  name             String?
  phone            String
  email            String?
  districtId       String?
  thanaId          String?
  areaId           String?
  locationSnapshot String?
  freeTextArea     String?
  locale           Locale        @default(EN)
  status           LeadStatus    @default(NEW)
  internalNote     String?       @db.Text
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  district         District?     @relation(fields: [districtId], references: [id], onDelete: SetNull)
  thana            Thana?        @relation(fields: [thanaId], references: [id], onDelete: SetNull)
  area             CoverageArea? @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([status])
}

model ConnectionRequest {
  id              String           @id @default(cuid())
  referenceCode   String           @unique
  name            String
  email           String?
  phone           String
  districtId      String?
  thanaId         String?
  areaId          String?
  districtName    String
  thanaName       String
  areaName        String
  areaCovered     Boolean          @default(true)
  fullAddress     String
  serviceType     ServiceType
  packageId       String?
  packageSnapshot String?
  message         String?          @db.Text
  locale          Locale           @default(EN)
  referrer        String?
  utm             Json?
  status          ConnectionStatus @default(NEW)
  internalNote    String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  district        District?        @relation(fields: [districtId], references: [id], onDelete: SetNull)
  thana           Thana?           @relation(fields: [thanaId], references: [id], onDelete: SetNull)
  area            CoverageArea?    @relation(fields: [areaId], references: [id], onDelete: SetNull)
  package         Package?         @relation(fields: [packageId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([status])
  @@index([serviceType])
  @@index([districtId])
  @@index([packageId])
}

model CorporateInquiry {
  id                String              @id @default(cuid())
  referenceCode     String              @unique
  companyName       String
  contactPerson     String
  email             String
  phone             String
  districtId        String?
  thanaId           String?
  officeAddress     String
  requiredBandwidth String?
  numberOfUsers     Int?
  message           String?             @db.Text
  locale            Locale              @default(EN)
  status            CorporateLeadStatus @default(NEW)
  internalNote      String?             @db.Text
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  district          District?           @relation(fields: [districtId], references: [id], onDelete: SetNull)
  thana             Thana?              @relation(fields: [thanaId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([status])
}

model ContactMessage {
  id            String        @id @default(cuid())
  referenceCode String        @unique
  name          String
  email         String?
  phone         String?
  subject       String
  message       String        @db.Text
  locale        Locale        @default(EN)
  status        ContactStatus @default(UNREAD)
  internalNote  String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([createdAt])
  @@index([status])
}

/// Status change history for any lead type (connection / corporate / contact / coverage interest).
model LeadStatusHistory {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  fromStatus String?
  toStatus   String
  note       String?  @db.Text
  actorId    String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
}

// ───────────────────────────── Payments ─────────────────────────────

model PaymentMethod {
  id                     String      @id @default(cuid())
  type                   PaymentType
  titleEn                String
  titleBn                String
  accountNumber          String
  accountTypeEn          String?
  accountTypeBn          String?
  bankName               String?
  accountName            String?
  branch                 String?
  routingNumber          String?
  referenceInstructionEn String?
  referenceInstructionBn String?
  instructionsEn         Json        @default("[]")
  instructionsBn         Json        @default("[]")
  qrMediaId              String?
  logoMediaId            String?
  active                 Boolean     @default(true)
  displayOrder           Int         @default(0)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  qrMedia                Media?      @relation("PaymentQr", fields: [qrMediaId], references: [id], onDelete: SetNull)
  logoMedia              Media?      @relation("PaymentLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)

  @@index([type, active, displayOrder])
}

// ───────────────────────────── Blog ─────────────────────────────

model BlogCategory {
  id           String     @id @default(cuid())
  slug         String     @unique
  nameEn       String
  nameBn       String
  active       Boolean    @default(true)
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  posts        BlogPost[]
}

model BlogPost {
  id                String        @id @default(cuid())
  slug              String        @unique
  titleEn           String
  titleBn           String
  excerptEn         String        @db.Text
  excerptBn         String        @db.Text
  contentEn         String        @db.Text
  contentBn         String        @db.Text
  featuredMediaId   String?
  categoryId        String?
  authorId          String?
  authorDisplayName String?
  status            BlogStatus    @default(DRAFT)
  featured          Boolean       @default(false)
  readMinutes       Int?
  publishedAt       DateTime?
  seoTitleEn        String?
  seoTitleBn        String?
  seoDescriptionEn  String?
  seoDescriptionBn  String?
  ogMediaId         String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  featuredMedia     Media?        @relation("BlogFeatured", fields: [featuredMediaId], references: [id], onDelete: SetNull)
  ogMedia           Media?        @relation("BlogOg", fields: [ogMediaId], references: [id], onDelete: SetNull)
  category          BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author            User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([categoryId])
}

// ───────────────────────────── FAQ / reviews / offers / offices ─────────────────────────────

model FAQCategory {
  id           String   @id @default(cuid())
  nameEn       String
  nameBn       String
  slug         String   @unique
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  faqs         FAQ[]
}

model FAQ {
  id           String       @id @default(cuid())
  categoryId   String?
  questionEn   String
  questionBn   String
  answerEn     String       @db.Text
  answerBn     String       @db.Text
  featured     Boolean      @default(false)
  active       Boolean      @default(true)
  displayOrder Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  category     FAQCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([active, displayOrder])
}

model Review {
  id            String   @id @default(cuid())
  displayName   String
  areaOrCompany String?
  quoteEn       String   @db.Text
  quoteBn       String   @db.Text
  rating        Int?
  avatarMediaId String?
  featured      Boolean  @default(false)
  published     Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  avatar        Media?   @relation(fields: [avatarMediaId], references: [id], onDelete: SetNull)

  @@index([published, displayOrder])
}

model Offer {
  id            String    @id @default(cuid())
  titleEn       String
  titleBn       String
  descriptionEn String    @db.Text
  descriptionBn String    @db.Text
  mediaId       String?
  ctaLabelEn    String?
  ctaLabelBn    String?
  ctaUrl        String?
  highlightsEn  Json      @default("[]")
  highlightsBn  Json      @default("[]")
  startAt       DateTime?
  endAt         DateTime?
  priority      Int       @default(0)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  media         Media?    @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([active, priority])
}

model Office {
  id           String     @id @default(cuid())
  nameEn       String
  nameBn       String
  type         OfficeType
  addressEn    String     @db.Text
  addressBn    String     @db.Text
  district     String?
  phone        String?
  email        String?
  mapUrl       String?
  latitude     Decimal?   @db.Decimal(9, 6)
  longitude    Decimal?   @db.Decimal(9, 6)
  hoursEn      String?
  hoursBn      String?
  isPrimary    Boolean    @default(false)
  active       Boolean    @default(true)
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([active, displayOrder])
}

// ───────────────────────────── Media ─────────────────────────────

model Media {
  id           String        @id @default(cuid())
  publicId     String        @unique
  secureUrl    String
  resourceType String        @default("image")
  format       String
  width        Int?
  height       Int?
  bytes        Int
  filename     String?
  altEn        String?
  altBn        String?
  category     MediaCategory @default(GENERAL)
  createdBy    String?
  createdAt    DateTime      @default(now())
  creator      User?         @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  brandLogoLight    BrandSetting[]     @relation("BrandLogoLight")
  brandLogoDark     BrandSetting[]     @relation("BrandLogoDark")
  brandFavicon      BrandSetting[]     @relation("BrandFavicon")
  brandDefaultOg    BrandSetting[]     @relation("BrandDefaultOg")
  seoEntries        SeoEntry[]
  corporateServices CorporateService[]
  paymentQrs        PaymentMethod[]    @relation("PaymentQr")
  paymentLogos      PaymentMethod[]    @relation("PaymentLogo")
  blogFeatured      BlogPost[]         @relation("BlogFeatured")
  blogOg            BlogPost[]         @relation("BlogOg")
  reviews           Review[]
  offers            Offer[]

  @@index([category, createdAt])
}

// ───────────────────────────── Chat ─────────────────────────────

model ChatVisitor {
  id              String             @id @default(cuid())
  publicTokenHash String             @unique
  name            String?
  phone           String?
  email           String?
  createdAt       DateTime           @default(now())
  lastSeenAt      DateTime           @default(now())
  conversations   ChatConversation[]
}

model ChatConversation {
  id                 String        @id @default(cuid())
  publicId           String        @unique
  visitorId          String
  assignedUserId     String?
  status             ChatStatus    @default(WAITING)
  locale             Locale        @default(EN)
  lastMessageAt      DateTime      @default(now())
  supportUnreadCount Int           @default(0)
  visitorUnreadCount Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  visitor            ChatVisitor   @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  assignedUser       User?         @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages           ChatMessage[]

  @@index([status, lastMessageAt])
  @@index([lastMessageAt])
  @@index([visitorId])
}

model ChatMessage {
  id              String           @id @default(cuid())
  conversationId  String
  senderType      ChatSenderType
  senderUserId    String?
  body            String           @db.Text
  createdAt       DateTime         @default(now())
  readByVisitorAt DateTime?
  readBySupportAt DateTime?
  conversation    ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser      User?            @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
}

// ───────────────────────────── Notifications / audit / email ─────────────────────────────

model Notification {
  id              String           @id @default(cuid())
  recipientUserId String?
  type            NotificationType
  title           String
  message         String
  entityType      String?
  entityId        String?
  readAt          DateTime?
  createdAt       DateTime         @default(now())
  recipient       User?            @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, readAt])
  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String?
  entityId    String?
  metadata    Json?
  ipHash      String?
  userAgent   String?
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId])
  @@index([entityType, entityId])
}

model EmailDeliveryLog {
  id                String      @id @default(cuid())
  template          String
  recipient         String
  relatedEntityType String?
  relatedEntityId   String?
  providerId        String?
  status            EmailStatus @default(PENDING)
  errorCode         String?
  createdAt         DateTime    @default(now())

  @@index([createdAt])
  @@index([status])
}

/// Idempotency / dedupe keys for public form submissions.
model SubmissionFingerprint {
  hash      String   @id
  entity    String
  entityId  String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// BTRC-approved tariff documents (PDF) shown on the public /tariff page.
model TariffDocument {
  id            String    @id @default(cuid())
  titleEn       String
  titleBn       String
  descriptionEn String?   @db.Text
  descriptionBn String?   @db.Text
  fileUrl       String
  fileName      String?
  memoNumber    String?
  issuedAt      DateTime?
  active        Boolean   @default(true)
  displayOrder  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([active, displayOrder])
}
